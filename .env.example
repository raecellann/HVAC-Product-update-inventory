# Copy this file to `.env` and fill in the values.
# Never commit `.env` to git.

# ---- Shopify store ----
# Your myshopify domain (NOT the admin URL). Example: my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from your Custom App (starts with "shpat_")
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify Admin API version. Stable quarterly releases. Keep current.
SHOPIFY_API_VERSION=2026-10

# ---- Inventory location ----
# The location GID to update. Find it with: python find_location.py
# Format: gid://shopify/Location/1234567890
SHOPIFY_LOCATION_ID=gid://shopify/Location/REPLACE_ME

# ---- Behavior ----
# How to interpret the Excel qty column:
#   absolute = set on-hand to exactly this number (safe, idempotent)
#   delta    = adjust by this amount (+/-). Dangerous if rerun.
QTY_MODE=absolute

# Excel column names (case-insensitive match)
EXCEL_SKU_COLUMN=SKU
EXCEL_QTY_COLUMN=Quantity
EXCEL_TITLE_COLUMN=Title

# Dry run — read Excel, match SKUs, but DO NOT push to Shopify.
# Set to "true" for the first run to verify matching.
DRY_RUN=true
